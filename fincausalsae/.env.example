# Copy this file to .env and fill in the values you need, then either
# `export $(cat .env | xargs)` before running scripts, or `pip install
# python-dotenv` and load it yourself. Nothing in DEMO mode requires
# any of these — they only matter for FULL mode / optional features.

# Only needed if you want:
#   - LLM-generated counterfactual transcripts in Phase 0 (full mode)
#   - Claude auto-labeling of discovered causal features in Phase 3
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Only needed in FULL mode if pulling gated models (e.g. meta-llama/*)
# from the Hugging Face Hub. Get a token at https://huggingface.co/settings/tokens
# and request access to the Llama license on the model page first.
HF_TOKEN=

# Only needed if you enable MLflow experiment tracking against a remote
# tracking server. Leave unset to log to a local ./mlruns folder instead.
MLFLOW_TRACKING_URI=
